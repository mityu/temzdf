{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  // The scripts written by hand: the shipped ones, the script host's
  // prelude and `temzdf` module, the tests' configurations and the
  // repository's Node scripts (cargo xtask check checks them).
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "crates/temzdf-script/runtime/**/*.ts",
      "crates/temzdf-script/src/prelude.ts",
      "crates/temzdf-script/src/temzdf.ts",
      // The declarations written by hand (not temzdf-all.d.ts, generated).
      "crates/temzdf-script/ts-types/temzdf-core.d.ts",
      "crates/temzdf-script/ts-types/temzdf-actions.d.ts",
      "crates/temzdf/tests/configs/*.ts",
      "tests/e2e/configs/*.ts",
      "tests/e2e/*.ts",
      "tests/e2e/lib/*.ts",
      "scripts/**/*.ts"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "javascript": {
    "formatter": { "quoteStyle": "double", "trailingCommas": "all", "semicolons": "always" }
  },
  "assist": { "enabled": false },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      // `x!` where the code knows a value is there (a match found, a
      // state set by the caller): checks would only add dead branches.
      "style": { "noNonNullAssertion": "off" }
    }
  },
  // The e2e scenarios wait and run things only through the harness's
  // helpers, which end on the test's abort signal (scripts/e2e/helpers.ts):
  // a timer or a process of their own would go on after a timeout.
  "overrides": [
    {
      "includes": ["tests/e2e/*.ts", "tests/e2e/lib/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "node:child_process": "Run programs with the helpers' `run`.",
                  "node:timers": "Wait with the helpers' `pause`.",
                  "node:timers/promises": "Wait with the helpers' `pause`.",
                  "node:fs": "Use the helpers' `fs`.",
                  "node:fs/promises": "Use the helpers' `fs`."
                }
              }
            }
          }
        }
      }
    }
  ]
}
