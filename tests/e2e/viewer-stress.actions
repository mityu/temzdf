# Used with: TERMPIX_MEDIUM=direct scripts/e2e.sh -t ghostty tests/e2e/viewer-stress.actions -- target/debug/temzdf standalone pdf --clean target/fixtures/sample.pdf
# Sends many compressed tiles inline (like over SSH): scroll the whole document,
# zoom in and out at several points. Pass = the terminal survives (exit code 0,
# not 3) and, once every tile of the last screen has arrived (wait_complete:
# inline transfers are slow), it is the one a headless render of the same
# input draws (expect stress-end).
wheel 30
pause 0.5
wheel -30
for i in 1 2 3; do
  wheel -2 $((200 * i)) 250 C
  pause 0.7
done
wheel 15
pause 0.7
wheel 6 400 300 C
pause 1
keys shift+g
pause 1.5
wait_complete
expect stress-end
