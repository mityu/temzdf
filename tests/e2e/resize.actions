# Resizing panes: dragging a border with the mouse (pixel coordinates from
# the terminal), then the shipped keys.
# Used with:
#   mkdir -p target/e2e-resize
#   scripts/e2e.sh -o target/e2e-resize tests/e2e/resize.actions -- sh -c \
#     'SHELL=/bin/sh PS1="$ " target/debug/temzdf --clean -s e2e-r; exec sh'
# Judged: expect for each. Expected (90x30 cells of 10x20 px):
#   dragged.png  the border at column 60: the left pane 60 columns wide, the
#                right one printing "30 29" (`stty size`)
#   keys.png     after C-b 5 > (five columns wider): the border at column 55, the right pane
#                printing "30 34"
keys ctrl+b percent
pause 1
# The border is column 44 (x 440-449).
xdotool mousemove 445 200 mousedown 1 mousemove 500 200 mousemove 605 200
pause 0.3
xdotool mouseup 1
pause 0.5
type "clear; stty size
"
pause 1
expect dragged
keys ctrl+b 5 greater Escape
type "clear; stty size
"
pause 1
expect keys
target/debug/temzdf kill-session e2e-r
