# Used with:
#   scripts/e2e.sh tests/e2e/select-autoscroll.actions -- sh -c \
#     'target/debug/temzdf standalone pdf --clean target/fixtures/sample-short.pdf; exec sh'
# Coordinates assume the default 900x600 window (fit width, page 1 at the top).
# Judged: dragging from the title into the bottom edge and holding scrolls
# the document by itself while the selection grows, until the end of the
# two pages (held, expect: the bottom of page 2, its page number selected;
# taken once the screen stood still, so it does not depend on how many
# frames the viewer drew, nor on how long that took); releasing copies the
# selection, from the title to the document's end, the last line and page
# 2's number (clipboard.txt; copied and to-end, check).
# The pointer stays right of the page number (x 480; at x 450 kitty left it
# out and WezTerm, one pixel to the right, took it in), so where the
# selection ends is in view at held.
# Also judged: each expect's cells against this terminal's own drawing
# of them, once temzdf ended (NAME.cells; scripts/e2e.sh).
pause 1
down 318 188
# kitty on macOS reports a press followed at once by motion at the motion's
# position (the selection then started below the title).
sleep 0.1
for y in 260 360 460 560 575; do move 480 $y; sleep 0.05; done
# Until the autoscroll stopped at the end.
wait_still
expect held
up
pause 0.5
clipboard >"$outdir/clipboard.txt" || true
check copied grep -q "^temzdf sample document" "$outdir/clipboard.txt"
check to-end sh -c 'tail -n 2 "$1" | head -n 1 | grep -qx "The end, with a last needle." && tail -n 1 "$1" | grep -qx 2' sh "$outdir/clipboard.txt"
