# Used with:
#   mkdir -p target/e2e-sync && cp target/fixtures/sample.{pdf,synctex.gz} target/e2e-sync/
#   scripts/e2e.sh tests/e2e/synctex.actions -- target/debug/temzdf standalone pdf --clean \
#     --editor 'echo %{input}:%{line} > target/e2e-sync/inverse.txt' target/e2e-sync/sample.pdf
# Judged (check): `temzdf --forward` from another process succeeds (forward);
# Ctrl+click on the title on page 1 runs the editor on sample.tex at a line
# of the title, from \title to the line after \maketitle (inverse).
# Expected:
#   forward.png  page 2 with the "Back to Section 1" line highlighted in red
line=$(grep -n "Back to Section" tests/fixtures/sample.tex | cut -d: -f1)
pause 1
check forward target/debug/temzdf --forward "$line:sample.tex" target/e2e-sync/sample.pdf
pause 0.8
shot forward
keys g
pause 1
rm -f target/e2e-sync/inverse.txt
click 450 188 1 C
pause 1
# The line SyncTeX gives for the title: where \maketitle ends.
inverse_on_title() {
  local got first last
  got=$(sed -nE 's|.*/tests/fixtures/sample\.tex:([0-9]+)$|\1|p' target/e2e-sync/inverse.txt 2>/dev/null)
  first=$(grep -n '^\\title' tests/fixtures/sample.tex | cut -d: -f1)
  last=$(($(grep -n '^\\maketitle' tests/fixtures/sample.tex | cut -d: -f1) + 1))
  [[ -n $got ]] && ((got >= first && got <= last))
}
check inverse inverse_on_title
