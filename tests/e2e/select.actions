# Used with:
#   scripts/e2e.sh tests/e2e/select.actions -- sh -c \
#     'target/debug/temzdf standalone pdf --clean target/fixtures/sample.pdf; exec sh'
# Coordinates assume the default 900x600 window (fit width, page 1 at the top).
# Judged (expect): dragging across the title selects it (blue) and the status
# bar says "Copied 22 characters" (selected); dragging in the margin pans
# instead (panned). Not judged: the clipboard holds the title (clipboard.txt).
# Also judged: each expect's cells against this terminal's own drawing
# of them, once temzdf ended (NAME.cells; scripts/e2e.sh).
pause 1
dragto 318 188 582 190 5
pause 0.5
expect selected
clipboard >"$outdir/clipboard.txt" || true
drag 50 400 300
pause 0.5
expect panned
