# A terminal without the kitty graphics protocol, as TERMPIX_GRAPHICS=off
# makes any terminal look: the viewer runs as text only.
# Used with: scripts/e2e.sh tests/e2e/no-graphics.actions -- env TERMPIX_GRAPHICS=off target/debug/temzdf standalone pdf --clean target/fixtures/sample.pdf
# Judged (check): no page is drawn (the middle of the screen is the
# terminal's dark background, not a white page; blank); the PDF pane's line
# and the message saying why show (line, why; kitty and WezTerm), and a key
# takes the message away (dismissed).
pause 1.5
shot start
# Mostly dark where a page would be white (the line crosses it): the middle
# of the terminal's cells (on macOS the screenshot is the whole display,
# with an alpha channel the mean would count).
dark_middle() {
  local mean
  read_geometry || return 1
  mean=$(magick "$outdir/start.png" -alpha off -crop "$((cols * cw))x$((rows * ch))+$origin_x+$origin_y" +repage \
    -gravity center -crop 50%x50%+0+0 +repage -colorspace gray -format '%[fx:mean]' info:)
  awk -v m="$mean" 'BEGIN { exit !(m < 0.2) }'
}
check blank dark_middle
check line screen_contains "PDF viewer disabled (no kitty graphics protocol support)"
check why screen_contains "TERMPIX_GRAPHICS=off"
keys j
pause 0.5
dismissed() {
  local status=0
  screen_contains "TERMPIX_GRAPHICS=off" || status=$?
  case $status in
    0) return 1 ;;
    77) return 77 ;;
    *) return 0 ;;
  esac
}
check dismissed dismissed
