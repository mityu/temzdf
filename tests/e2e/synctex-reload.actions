# Forward search sent right after a rebuild, as an editor's compile callback
# (vimtex) does: it must land in the new version.
# Used with:
#   mkdir -p target/e2e-sync-reload && cp target/fixtures/sample.{pdf,synctex.gz} target/e2e-sync-reload/
#   scripts/e2e.sh tests/e2e/synctex-reload.actions -- sh -c \
#     'target/debug/temzdf standalone pdf --config tests/e2e/configs/forward.ts target/e2e-sync-reload/sample.pdf; exec sh'
# (forward.ts: the forward search's highlight stays until the next input.)
# Judged: the forward search after the rebuild succeeds (forward-sent,
# check) and shows page 1 of the new version (six "Inserted paragraph"
# lines) with the line starting "This document exercises" highlighted in
# red, not the place that line had before the rebuild (forward, expect:
# the replay opens the new version and sends both searches, the first
# one, for the old version, to the new SyncTeX data).
# Also judged: each expect's cells against this terminal's own drawing
# of them, once temzdf ended (NAME.cells; scripts/e2e.sh).
line=$(grep -n "^This document exercises" tests/fixtures/sample-insert.tex | cut -d: -f1)
pause 1
# A first forward search loads the old SyncTeX data into the viewer.
forward "$(grep -n "^Back to Section" tests/fixtures/sample.tex | cut -d: -f1):sample.tex" target/e2e-sync-reload/sample.pdf
pause 1
keys g
pause 0.5
# Replace by rename, like latexmk; the PDF first, then the SyncTeX data.
cp target/fixtures/sample-insert.pdf target/e2e-sync-reload/new.pdf
mv target/e2e-sync-reload/new.pdf target/e2e-sync-reload/sample.pdf
cp target/fixtures/sample-insert.synctex.gz target/e2e-sync-reload/sample.synctex.gz
check forward-sent forward "$line:sample-insert.tex" target/e2e-sync-reload/sample.pdf
pause 0.8
expect forward
