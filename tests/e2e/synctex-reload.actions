# Forward search sent right after a rebuild, as an editor's compile callback
# (vimtex) does: it must land in the new version.
# Used with:
#   mkdir -p target/e2e-sync && cp target/fixtures/sample.{pdf,synctex.gz} target/e2e-sync/
#   scripts/e2e.sh tests/e2e/synctex-reload.actions -- target/debug/temzdf standalone pdf target/e2e-sync/sample.pdf
# Expected:
#   forward.png  page 1 of the new version (six "Inserted paragraph" lines) with
#                the line starting "This document exercises" highlighted in red,
#                not the place that line had before the rebuild
line=$(grep -n "^This document exercises" tests/fixtures/sample-insert.tex | cut -d: -f1)
pause 1
# A first forward search loads the old SyncTeX data into the viewer.
target/debug/temzdf --forward "$(grep -n "^Back to Section" tests/fixtures/sample.tex | cut -d: -f1):sample.tex" target/e2e-sync/sample.pdf
pause 1
keys g
pause 0.5
# Replace by rename, like latexmk; the PDF first, then the SyncTeX data.
cp target/fixtures/sample-insert.pdf target/e2e-sync/new.pdf
mv target/e2e-sync/new.pdf target/e2e-sync/sample.pdf
cp target/fixtures/sample-insert.synctex.gz target/e2e-sync/sample.synctex.gz
target/debug/temzdf --forward "$line:sample-insert.tex" target/e2e-sync/sample.pdf
pause 0.8
shot forward
