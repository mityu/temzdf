# Japanese input in the GUI: fcitx5 with Mozc over XIM, into a shell.
# Used with:
#   cargo build -p temzdf -p temzdf-gui
#   scripts/e2e.sh -t gui -I -o target/e2e-gui-ime tests/e2e/gui-ime.actions -- \
#     env SHELL=/bin/sh PS1='$ ' target/debug/temzdf-gui
# Expected: composing.png shows "にほん" being composed at the prompt
# (Mozc's window at the cursor); ime.txt holds "got:にほん" (committed
# text reached the shell); pasted.txt holds "got:pasted" (Ctrl+Shift+V
# pasted the clipboard).
pause 1
type "read l; echo \"got:\$l\" > $outdir/ime.txt
"
pause 0.5
ime on
pause 0.5
xdotool type --delay 80 nihonn
pause 1
shot composing
keys Return
ime off
pause 0.3
keys Return
pause 1
type "read l; echo \"got:\$l\" > $outdir/pasted.txt
"
printf pasted | xclip -selection clipboard
pause 0.3
keys ctrl+shift+v Return
pause 1
expect done
