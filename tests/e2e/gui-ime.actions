# Japanese input in the GUI: fcitx5 with Mozc into a shell, over XIM on X11
# and over input-method-v2 and text-input-v3 on Wayland (add -d wayland).
# Used with:
#   cargo build -p temzdf -p temzdf-gui
#   scripts/e2e.sh -t gui -I -o target/e2e-gui-ime tests/e2e/gui-ime.actions -- \
#     env SHELL=/bin/sh PS1='$ ' target/debug/temzdf-gui --clean
# Judged: expect done; check: ime.txt holds "got:にほん" (committed text
# reached the shell; ime), pasted.txt holds "got:pasted" (Ctrl+Shift+V
# pasted the clipboard; pasted). Not judged: composing.png shows "にほん"
# being composed at the prompt (Mozc's window at the cursor).
pause 1
type "read l; echo \"got:\$l\" > $outdir/ime.txt
"
pause 0.5
ime on
pause 0.5
type nihonn 80
pause 1
shot composing
keys Return
ime off
pause 0.3
keys Return
pause 1
type "read l; echo \"got:\$l\" > $outdir/pasted.txt
"
set_clipboard pasted
pause 0.3
keys ctrl+shift+v Return
pause 1
expect done
check ime grep -qx "got:にほん" "$outdir/ime.txt"
check pasted grep -qx "got:pasted" "$outdir/pasted.txt"
