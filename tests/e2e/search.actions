# Used with:
#   scripts/e2e.sh tests/e2e/search.actions -- sh -c \
#     'target/debug/temzdf standalone pdf --clean target/fixtures/sample.pdf; exec sh'
# Judged (expect: each screen compared with --render-frame replaying the same
# input): typing shows the input line below the page with incremental
# highlights (typing), Enter + n moves to the next hit (next), Esc clears
# highlights (cleared).
# Also judged: each expect's cells against this terminal's own drawing
# of them, once temzdf ended (NAME.cells; scripts/e2e.sh).
keys slash
type needle
pause 0.8
expect typing
keys Return n
pause 0.8
expect next
keys Escape
pause 0.5
expect cleared
