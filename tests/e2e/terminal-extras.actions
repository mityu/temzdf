# Terminal panes: images from programs, selection, links, the scrollback
# position.
# Used with:
#   mkdir -p target/e2e-term-extras
#   scripts/e2e.sh -o target/e2e-term-extras tests/e2e/terminal-extras.actions -- sh -c \
#     'SHELL=/bin/sh PS1="$ " target/debug/temzdf --clean -s e2e-x; exec sh'
# Judged: expect for image, selected and scrolled. Expected:
#   image.png     the right pane (C-b %): a red-to-blue gradient of 16x4 cells
#                 below "select me please" and "a link" (a PNG sent as a file
#                 path, t=f)
#   selected.png  "select" inverted (dragged)
#   scrolled.png  the right pane scrolled back one wheel step: "[3/N]" at its
#                 top right
magick -size 160x80 gradient:red-blue "$outdir/img.png"
keys ctrl+b percent
pause 1
type "clear; printf 'select me please\n\033]8;;https://example.org\033\\\\a link\033]8;;\033\\\\\n'; printf '\033_Ga=T,f=100,t=f,c=16,r=4,q=2;%s\033\\\\' \"\$(printf %s $outdir/img.png | base64 -w0)\"; echo
"
pause 1.5
expect image
# Cells are 10x20 px: "select" is columns 45-50 of the first row.
xdotool mousemove 451 10 mousedown 1 mousemove 480 10 mousemove 508 10
pause 0.3
xdotool mouseup 1
pause 0.5
expect selected
type "seq 1 100
"
pause 1
wheel -1 700 300
pause 0.5
expect scrolled
target/debug/temzdf kill-session e2e-x
