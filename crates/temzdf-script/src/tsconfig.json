{
  // The script host's prelude (prelude.ts) and the `temzdf` module
  // (temzdf.ts): what the prelude builds is typed as the `temzdf` module of
  // the declarations by hand, and temzdf.ts exports exactly that (for
  // editors and crates/temzdf/tests/types.rs). QuickJS runs them: no DOM,
  // no Node.
  "compilerOptions": {
    "strict": true, "noEmit": true, "target": "es2022", "module": "esnext",
    "moduleResolution": "bundler", "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true, "types": [], "lib": ["es2022"]
  },
  "files": ["prelude.ts", "temzdf.ts", "../ts-types/temzdf-core.d.ts", "../ts-types/temzdf-actions.d.ts"]
}
